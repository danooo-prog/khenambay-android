<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Khenambay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/zamrud</item>
        <item name="colorAccent">@color/emas</item>
        <item name="android:windowBackground">@color/malam</item>
        <item name="android:statusBarColor">@color/malam</item>
        <item name="android:navigationBarColor">@color/malam</item>
    </style>

    <!-- Layar pembuka: logo cenderawasih di atas latar malam Sentani -->
    <style name="Theme.Khenambay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/malam</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Khenambay</item>
    </style>
</resources>
